Main.asv
Data/Draft_21Feb2026.pdf

# Editor autosave snapshots of the draft (a batch of these was committed by
# accident once and had to be removed in e9e8dd2)
*.tex.tmp.*

# Markdown mirror of the paper library. Generated from the committed PDFs by
# Data/Key papers/pdf_to_markdown.py; regenerates in seconds, so tracking it
# would only add diff noise. The PDFs are the source of record.
Data/Key papers/markdown/

# LaTeX build artifacts for the standalone notes in Data/Notes/. The .tex and
# .pdf are the record; these regenerate on any build.
Data/Notes/*.aux
Data/Notes/*.log
Data/Notes/*.out
Data/Notes/*.synctex.gz

# Python bytecode caches. Regenerated on every run and specific to the
# interpreter version; tracked copies were removed Oct 29, 2026.
__pycache__/
*.pyc
