Here is a Dynare mod file with Feenstra-style translog preferences (as in Bilbiie–Ghironi–Melitz) that preserves your steady-state markup μ = ε/(ε−1) and maps love-of-variety to half the net markup in steady state. [4][5]

---------------------------------
var C N_e N d nu w L L_C L_E Y Y_r rho 
    log_Y log_Y_r log_L log_L_C log_L_E
    Z  mu epsi;

varexo e_z;

parameters beta r delta chi psi f_e sigma rho_z sigma_m mu_ss;

// Calibration 
beta   = 0.99;
r      = (1-beta)/beta;
delta  = 0.025;
chi    = 0.9241;
psi    = 4.0;
mu_ss = 3.8/(3.8-1);
f_e    = 1.0;
sigma  = 1.0;

rho_z  = 0.979;

#epsi_ss = mu_ss/(mu_ss-1);
#N_ss     = (1 - delta)*L_bar/(f_e*(r + delta)*(epsi - 1) + delta);
sigma_m = 1/((mu_ss-1)*N_ss);

model;
// Translog markup schedule (Feenstra-style, symmetric equilibrium):
mu = 1 + 1/(sigma_m*N);

epsi = mu/(mu-1);

// Love-of-variety under translog: equals half the net price markup (in symmetric equilibrium)
rho = sqrt(N)*exp(1/(2*sigma_m*N));

// Consumption sector and wages
C = Z*rho*L_C;
w = rho*Z/mu;

// Labor supply and allocation
L = (w*C^(-sigma)/chi)^psi;
L_E = L - L_C;

// Free entry condition
nu = w*f_e/Z;

// Profits per firm: margin times per-firm revenue
d = ((mu - 1)/mu) * (C/N);

// Aggregate accounting
nu*N_e + C = w*L + N*d;

// Output and data-consistent output
Y   = C + nu*N_e;
Y_r = Y/rho;

// Firm population law of motion
N = (1 - delta)*(N(-1) + N_e(-1));

// Exogenous process
log(Z) = rho_z*log(Z(-1)) + e_z;

// IRF variables (percent, in logs)
log_Y   = 100*log(Y);
log_Y_r = 100*log(Y_r);
log_L   = 100*log(L);
log_L_C = 100*log(L_C);
log_L_E = 100*log(L_E);
log_Z   = 100*log(Z);
end;

initval;
  // Technology
  Z     = 1;
  L     = 0.8;
  mu = mu_ss;
  epsi = mu/(mu-1);
  N     = (1 - delta)*Z*L/(f_e*(r + delta)*(epsi - 1) + delta);
  rho = sqrt(N)*exp(1/(2*sigma_m*N));
 
  // Sectoral labor, consumption, entry, profits
  L_C   = (epsi - 1)*(r + delta)*L/((epsi - 1)*(r + delta) + delta);
  L_E   = L - L_C;
  C     = Z*rho*L_C;

  w     = rho*Z/mu;
  nu    = w*f_e/Z;
  d     = C/(epsi*N);

  // Entrants and outputs
  N_e   = delta*N/(1 - delta);
  Y     = C + nu*N_e;
  Y_r   = Y/rho;

  // Logs for IRFs
  log_Y   = 100*log(Y);
  log_Y_r = 100*log(Y_r);
  log_L   = 100*log(L);
  log_L_C = 100*log(L_C);
  log_L_E = 100*log(L_E);
  log_Z = 100*log(Z);
end;

shocks;
  var e_z = 0.01^2;
end;

resid;
steady;
check;

stoch_simul(order=2, irf=40) log_Z log_Y log_Y_r log_L log_L_C log_L_E N rho;
---------------------------------

//μt is endogenous and varies with Nt under translog; Θ is calibrated in steady state so μ_ss equals ε/(ε−1), matching your original markup target. [4]

/