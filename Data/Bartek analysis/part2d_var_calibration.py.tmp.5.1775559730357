def _build_panel() -> pd.DataFrame:
    """
    Build the residualized industry-quarter panel (ν^δ, ν^{LD}).

    Loads raw shock rates from cache, attaches controls (aggregate productivity,
    lagged market tightness, lagged industry VA growth), and residualizes each
    series within industry.  Residualization is performed in-process from the
    read-only cache parquets to avoid NTFS-mount corruption of any previously
    written instrument files.

    Returns a DataFrame with columns:
      industry_code, quarter_label, industry_label,
      log_g_delta, log_g_ld,    -- raw log shock rates
      nu_delta, nu_ld            -- residualized series (ν^k)
    """
    # ── check inputs ──────────────────────────────────────────────────────────
    for p in [SHOCK_RATES_PATH, SHOCK_RATES_LD_PATH]:
        if not p.exists():
            sys.exit(f"Missing shock rate file: {p}\nRun part2_shock_rates.py first.")

    required_caches = [
        DEFAULT_CACHE_DIR / "ophnfb_quarterly.parquet",
        DEFAULT_CACHE_DIR / "national_tightness_quarterly.parquet",
        DEFAULT_CACHE_DIR / "bea_va_quarterly_12ind.parquet",
    ]
    missing = [p for p in required_caches if not p.exists()]
    if missing:
        msg = "\n".join(f"  {p}" for p in missing)
        sys.exit(f"Missing cache files:\n{msg}\n"
                 "Run part2b_shock_comovement.py with FRED_API_KEY set first.")

    # ── raw shock rates: average LOO rates across states ──────────────────────
    def _nat_avg(path, col, new_col):
        df = pd.read_parquet(path)
        return (df.groupby(["industry_code", "quarter_label"])[col]
                  .mean().reset_index().rename(columns={col: new_col}))

    nat = (_nat_avg(SHOCK_RATES_PATH,    "g_delta_loo", "g_delta")
           .merge(_nat_avg(SHOCK_RATES_LD_PATH, "g_ld_loo", "g_ld"),
                  on=["industry_code", "quarter_label"], how="inner"))
    nat = nat[(nat.g_delta > 0) & (nat.g_ld > 0)].copy()
    nat["log_g_delta"]  = np.log(nat["g_delta"])
    nat["log_g_ld"]     = np.log(nat["g_ld"])
    nat["industry_code"] = nat["industry_code"].astype(int)

    print(f"  Raw panel: {nat['quarter_label'].min()}–{nat['quarter_label'].max()}, "
          f"{nat['industry_code'].nunique()} industries, {len(nat):,} obs")

    # ── attach controls ───────────────────────────────────────────────────────
    # Aggregate productivity growth: Δlog p_t
    prod = pd.read_parquet(DEFAULT_CACHE_DIR / "ophnfb_quarterly.parquet")
    prod = prod.sort_values("quarter_label").reset_index(drop=True)
    prod["dlog_p"] = np.log(prod["productivity"]).diff()

    # Lagged market tightness: log θ_{t-1}
    tight = pd.read_parquet(DEFAULT_CACHE_DIR / "national_tightness_quarterly.parquet")
    tight = tight.sort_values("quarter_label").reset_index(drop=True)
    tight["log_theta_lag"] = tight["log_theta"].shift(1)

    # Lagged industry VA growth: Δlog VA_{j,t-1}
    bea = pd.read_parquet(DEFAULT_CACHE_DIR / "bea_va_quarterly_12ind.parquet")
    bea = bea.sort_values(["industry_code", "quarter_label"]).reset_index(drop=True)
    bea["dlog_va_lag"] = bea.groupby("industry_code")["dlog_va"].shift(1)
    bea_lag = bea[["industry_code", "quarter_label", "dlog_va_lag"]].dropna().copy()
    bea_lag["industry_code"] = bea_lag["industry_code"].astype(int)

    nat = (nat
           .merge(prod[["quarter_label", "dlog_p"]].dropna(),
                  on="quarter_label", how="inner")
           .merge(tight[["quarter_label", "log_theta_lag"]].dropna(),
                  on="quarter_label", how="inner")
           .merge(bea_lag, on=["industry_code", "quarter_label"], how="inner"))
    nat = nat.dropna().sort_values(["industry_code", "quarter_label"]).reset_index(drop=True)

    print(f"  After controls: {nat['quarter_label'].min()}–{nat['quarter_label'].max()}, "
          f"{nat['industry_code'].nunique()} industries, {len(nat):,} obs")

    # ── within-industry residualization ───────────────────────────────────────
    # Project log g^k on industry FEs + controls; retain residuals ν^k.
    # Estimator: demean within industry, then OLS on demeaned regressors.
    def _residualize(df, dep_col, resid_col, reg_cols):
        """
        Estimates (dep - mean_j(dep)) = Σ_k γ_k (reg_k - mean_j(reg_k)) + ν
        Returns df with resid_col added.
        """
        work = df[["industry_code", dep_col, *reg_cols]].copy().reset_index(drop=True)
        work["y_dm"] = (work[dep_col]
                        - work.groupby("industry_code")[dep_col].transform("mean"))
        dm_cols = []
        for rc in reg_cols:
            dc = f"_dm_{rc}"
            work[dc] = work[rc] - work.groupby("industry_code")[rc].transform("mean")
            dm_cols.append(dc)
        X      = work[dm_cols].to_numpy()
        y      = work["y_dm"].to_numpy()
        gammas = np.linalg.lstsq(X, y, rcond=None)[0]
        resid  = y - X @ gammas
        r2     = 1 - (resid ** 2).sum() / max((y ** 2).sum(), 1e-12)
        coef_str = "  ".join(f"{rc}={g:+.4f}" for rc, g in zip(reg_cols, gammas))
        print(f"    {resid_col:<12}  {coef_str}   R²={r2:.4f}")
        out = df.copy()
        out[resid_col] = resid
        return out

    print("\n  Residualizing:")
    # δ: productivity + industry demand; LD: add tightness (quits respond to θ)
    nat = _residualize(nat, "log_g_delta", "nu_delta",
                       ("dlog_p", "dlog_va_lag"))
    nat = _residualize(nat, "log_g_ld",    "nu_ld",
                       ("dlog_p", "dlog_va_lag", "log_theta_lag"))

    nat["industry_label"] = nat["industry_code"].map(INDUSTRY_LABELS)

    r_raw   = nat["log_g_delta"].corr(nat["log_g_ld"])
    r_resid = nat["nu_delta"].corr(nat["nu_ld"])
    print(f"\n  r(δ, LD): raw={r_raw:+.3f}  →  residualized={r_resid:+.3f}")

    return nat


# ═══════════════════════════════════════════════════════════════════════════════
#  VAR ESTIMATOR
#  Two-way within transformation absorbs industry + time FEs, then OLS
#  equation by equation.  Numerically equivalent to absorbing FEs via
#  Frisch-Waugh-Lovell.
#
#  Bias note: Nickell (1981) bias is O(1/T).  With T ≈ 65 quarters, bias ≈
#  1.5% — small relative to economic magnitudes; no Kiviet correction applied.
# ═══════════════════════════════════════════════════════════════════════════════

def _two_way_demean(df, series_cols,
                    ind_col="industry_code", time_col="quarter_label"):
    """
    Standard two-way within transformation: subtract industry means, time
    means, and add back the grand mean.  Returns df with demeaned series.
    """
    out = df.copy()
    grand      = {c: df[c].mean() for c in series_cols}
    ind_means  = df.groupby(ind_col)[series_cols].transform("mean")
    time_means = df.groupby(time_col)[series_cols].transform("mean")
    for c in series_cols:
        out[c] = df[c] - ind_means[c] - time_means[c] + grand[c]
    return out


def _build_var_data(df, y_cols, n_lags,
                    ind_col="industry_code", time_col="quarter_label"):
    """
    Stack the VAR regression matrices across industries.

    For each industry j with T_j observations, creates rows t = n_lags,...,T_j-1:
      Y[t] = y_{j,t}                          (K-vector, contemporaneous)
      X[t] = [y_{j,t-1}', ..., y_{j,t-L}']   (K*L-vector, lagged block)

    Returns:
      Y    : (N, K) array of contemporaneous observations
      X    : (N, K*L) array of stacked lags
      meta : DataFrame aligning each row to (industry_code, quarter_label)
    """
    K = len(y_cols)
    Y_list, X_list, meta_list = [], [], []
    for ind, grp in df.groupby(ind_col):
        grp  = grp.sort_values(time_col).reset_index(drop=True)
        vals = grp[y_cols].to_numpy()   # T_j × K
        for t in range(n_lags, len(grp)):
            X_list.append(np.concatenate([vals[t - l] for l in range(1, n_lags + 1)]))
            Y_list.append(vals[t])
            meta_list.append({ind_col: ind, time_col: grp[time_col].iloc[t]})
    return np.array(Y_list), np.array(X_list), pd.DataFrame(meta_list)


def _estimate_var(df, y_cols, n_lags,
                  ind_col="industry_code", time_col="quarter_label"):
    """
    Estimate panel VAR(n_lags) by two-way within OLS.

    Returns:
      A_list : [A_1, ..., A_L], each K×K; A_l[i,j] = response of i to lag-l of j
      Sigma  : K×K innovation covariance (df-corrected)
      meta   : row-alignment DataFrame
      resid  : (N, K) OLS residuals
      Y_dm   : (N, K) demeaned LHS
    """
    K     = len(y_cols)
    df_dm = _two_way_demean(df, y_cols, ind_col=ind_col, time_col=time_col)
    Y_dm, X_dm, meta = _build_var_data(df_dm, y_cols, n_lags, ind_col, time_col)
    N     = len(Y_dm)

    # Equation-by-equation OLS: lstsq returns (K*L × K); transpose to (K × K*L)
    B = np.linalg.lstsq(X_dm, Y_dm, rcond=None)[0].T
    resid = Y_dm - X_dm @ B.T   # (N, K)

    # Unbiased Σ: degrees of freedom = N - K*L params per equation
    Sigma = (resid.T @ resid) / (N - K * n_lags)

    # Extract A_l: B[:, l*K:(l+1)*K] for l = 0,...,L-1
    A_list = [B[:, l * K : (l + 1) * K] for l in range(n_lags)]

    return A_list, Sigma, meta, resid, Y_dm


def _aic_bic(Sigma, N, K, n_lags):
    """
    Multivariate AIC and BIC based on log|Σ|.

    AIC = log|Σ| + 2 * K^2 * L / N
    BIC = log|Σ| + log(N) * K^2 * L / N
    FEs are concentrated out and not penalized.
    """
    log_det = np.log(np.linalg.det(Sigma))
    n_free  = K ** 2 * n_lags
    return (log_det + 2 * n_free / N,
            log_det + np.log(N) * n_free / N)


# ═══════════════════════════════════════════════════════════════════════════════
#  STRUCTURAL IRFs
#  Cholesky identification with δ ordered first.  IRFs computed via companion-
#  form recursion; bootstrap CIs via residual resampling.
# ═══════════════════════════════════════════════════════════════════════════════

def _companion_matrix(A_list, K):
    """
    Build (K*L × K*L) companion matrix from [A_1,...,A_L].

    Top K rows: [A_1 | A_2 | ... | A_L]
    Lower rows: shift identity [I_{K*(L-1)} | 0]
    """
    L, KL = len(A_list), K * len(A_list)
    comp  = np.zeros((KL, KL))
    for l, Al in enumerate(A_list):
        comp[:K, l * K : (l + 1) * K] = Al
    if L > 1:
        comp[K:, : K * (L - 1)] = np.eye(K * (L - 1))
    return comp


def _compute_structural_irfs(A_list, P, K, n_irf):
    """
    Structural IRFs via companion-form recursion.

    For each structural shock i (Cholesky column i, 1-SD impulse):
      · Initialize state = [P[:,i], 0,...,0] in companion space.
      · Iterate Y_{h+1} = A_comp Y_h for h = 0,...,n_irf.
      · Extract first K elements at each horizon.

    Returns dict: key = '{shock}_to_{series}', value = (n_irf+1,) array.
    Shock ordering: delta (i=0), ld (i=1), matching y_cols = [nu_delta, nu_ld].
    """
    comp   = _companion_matrix(A_list, K)
    KL     = comp.shape[0]
    labels = ["delta", "ld"]
    irfs   = {}

    for i, shock in enumerate(labels):
        state             = np.zeros(KL)
        state[:K]         = P[:, i]                  # Cholesky column i
        responses         = np.zeros((n_irf + 1, K))
        responses[0]      = state[:K]                # h=0: contemporaneous
        for h in range(1, n_irf + 1):
            state        = comp @ state
            responses[h] = state[:K]
        for j, series in enumerate(labels):
            irfs[f"{shock}_to_{series}"] = responses[:, j]

    return irfs


def _bootstrap_irfs(df, y_cols, n_lags, K, n_irf, B=500, seed=42):
    """
    Residual bootstrap for VAR structural IRF confidence bands.

    Each replication: draw N residuals with replacement, add to fitted values,
    re-estimate VAR + Cholesky, record IRFs.  Returns (ci_lo, ci_hi) dicts.
    """
    rng = np.random.default_rng(seed)
    A0, S0, meta0, res0, Ydm0 = _estimate_var(df, y_cols, n_lags)
    Y_hat = Ydm0 - res0
    N0    = len(res0)

    irf_boots = {k: [] for k in _compute_structural_irfs(A0, np.linalg.cholesky(S0), K, n_irf)}

    for _ in range(B):
        idx    = rng.integers(0, N0, size=N0)
        Y_b    = Y_hat + res0[idx]
        df_b   = df.copy()
        tmp    = meta0.copy()
        tmp[y_cols[0] + "_b"] = Y_b[:, 0]
        tmp[y_cols[1] + "_b"] = Y_b[:, 1]
        df_b   = df_b.merge(tmp, on=["industry_code", "quarter_label"], how="left")
        mask   = df_b[y_cols[0] + "_b"].notna()
        for j, c in enumerate(y_cols):
            df_b.loc[mask, c] = df_b.loc[mask, c + "_b"]
        df_b   = df_b.drop(columns=[c + "_b" for c in y_cols])
        try:
            Ab, Sb, _, _, _ = _estimate_var(df_b, y_cols, n_lags)
            irfs_b = _compute_structural_irfs(Ab, np.linalg.cholesky(Sb), K, n_irf)
            for k in irf_boots:
                irf_boots[k].append(irfs_b[k])
        except (np.linalg.LinAlgError, ValueError):
            continue

    alpha = (1 - CI_LEVEL) / 2
    ci_lo = {k: np.quantile(np.array(v), alpha,     axis=0) for k, v in irf_boots.items() if v}
    ci_hi = {k: np.quantile(np.array(v), 1 - alpha, axis=0) for k, v in irf_boots.items() if v}
    return ci_lo, ci_hi


