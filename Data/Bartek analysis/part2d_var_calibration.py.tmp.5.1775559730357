def _save_output(A_list, Sigma, P, irfs_point, ci_lo, ci_hi,
                 n_ind, t_span, N_est, selected_lags):
    """Save IRF plot and calibration CSV; print summary."""
    K  = 2
    A1 = A_list[0]

    rho_delta  = A1[0, 0]
    rho_ld     = A1[1, 1]
    beta_endex = A1[1, 0]
    alpha_rev  = A1[0, 1]
    corr_innov = Sigma[0, 1] / np.sqrt(Sigma[0, 0] * Sigma[1, 1])
    cum_delta  = irfs_point["delta_to_delta"].sum()
    cum_ld     = irfs_point["ld_to_ld"].sum()
    HORIZONS   = list(range(N_IRF + 1))

    # ── IRF plot ──────────────────────────────────────────────────────────────
    fig, axes = plt.subplots(2, 2, figsize=(10, 7))
    fig.suptitle(
        "Bivariate Panel VAR: Structural IRFs on Shock Series\n"
        f"(VAR({selected_lags}), residualized ν, industry+time FEs, "
        f"{int(CI_LEVEL*100)}% bootstrap CIs)",
        fontsize=11
    )
    panel_info = [
        (0, 0, "delta_to_delta", "ε^δ shock",   "ν^δ (est. closings)",  "#1f77b4"),
        (0, 1, "delta_to_ld",    "ε^δ shock",   "ν^{LD} (layoffs)",     "#d62728"),
        (1, 0, "ld_to_delta",    "ε^{LD} shock", "ν^δ (est. closings)", "#1f77b4"),
        (1, 1, "ld_to_ld",       "ε^{LD} shock", "ν^{LD} (layoffs)",    "#d62728"),
    ]
    for row, col, key, shock_lbl, resp_lbl, color in panel_info:
        ax = axes[row, col]
        pt = irfs_point[key]
        lo = ci_lo.get(key, pt)
        hi = ci_hi.get(key, pt)
        ax.fill_between(HORIZONS, lo, hi, alpha=0.20, color=color,
                        label=f"{int(CI_LEVEL*100)}% CI")
        ax.plot(HORIZONS, pt, color=color, lw=2, label="Point estimate")
        ax.axhline(0, color="black", lw=0.8, ls="--")
        ax.set_title(f"Response of {resp_lbl}\nto 1-SD {shock_lbl}", fontsize=9)
        ax.set_xlabel("Quarters", fontsize=8)
        ax.set_ylabel("Log rate response", fontsize=8)
        ax.tick_params(labelsize=8)
        ax.legend(fontsize=7)
    plt.tight_layout()
    p_irf = RESULTS_DIR / "var_irf_chol.png"
    fig.savefig(p_irf, dpi=150, bbox_inches="tight")
    plt.close(fig)
    print(f"  IRF plot saved: {p_irf}")

    # ── calibration CSV ───────────────────────────────────────────────────────
    P_inv = np.linalg.inv(P)
    calib = pd.DataFrame([
        {"Parameter": "rho_delta_lag1",  "Value": round(rho_delta, 4),
         "Interpretation": "Own-persistence of δ at lag 1 (≈ AR(1) rho_δ)"},
        {"Parameter": "rho_ld_lag1",     "Value": round(rho_ld, 4),
         "Interpretation": "Own-persistence of LD at lag 1 (≈ AR(1) rho_s)"},
        {"Parameter": "beta_endex",      "Value": round(beta_endex, 4),
         "Interpretation": "LD response to 1-lag δ (endogenous exit channel)"},
        {"Parameter": "alpha_reverse",   "Value": round(alpha_rev, 4),
         "Interpretation": "δ response to 1-lag LD (should be ~0 if δ is primitive)"},
        {"Parameter": "corr_innov",      "Value": round(corr_innov, 4),
         "Interpretation": "Corr(u^δ, u^LD) — reduced-form innovation correlation"},
        {"Parameter": "corr_structural",
         "Value": round(P_inv[0, :] @ P[:, 1]
                        / np.sqrt(P_inv[0, :] @ P_inv[0, :].T), 4),
         "Interpretation": "Cross-shock correlation after Cholesky (0 by construction)"},
        {"Parameter": "sd_innov_delta",  "Value": round(np.sqrt(Sigma[0, 0]), 4),
         "Interpretation": "SD of reduced-form δ innovation"},
        {"Parameter": "sd_innov_ld",     "Value": round(np.sqrt(Sigma[1, 1]), 4),
         "Interpretation": "SD of reduced-form LD innovation"},
        {"Parameter": "sd_struct_delta", "Value": round(P[0, 0], 4),
         "Interpretation": "SD of structural δ shock (Cholesky)"},
        {"Parameter": "sd_struct_ld",    "Value": round(P[1, 1], 4),
         "Interpretation": "SD of structural LD shock (Cholesky, orth. component)"},
        {"Parameter": "cum_irf_delta",   "Value": round(cum_delta, 4),
         "Interpretation": "Cumulative ε^δ → ν^δ IRF (h=0..12) — total persistence"},
        {"Parameter": "cum_irf_ld",      "Value": round(cum_ld, 4),
         "Interpretation": "Cumulative ε^LD → ν^LD IRF (h=0..12) — total persistence"},
        {"Parameter": "selected_lags",   "Value": selected_lags,
         "Interpretation": "Lag length selected by AIC/BIC"},
        {"Parameter": "N_obs",           "Value": N_est,
         "Interpretation": "Estimation sample size (industry-quarter obs)"},
        {"Parameter": "N_industries",    "Value": n_ind,
         "Interpretation": "Number of industries"},
        {"Parameter": "sample_span",     "Value": t_span,
         "Interpretation": "Residualized panel sample"},
    ])
    p_calib = RESULTS_DIR / "var_calibration.csv"
    calib.to_csv(p_calib, index=False)
    print(f"  Calibration table saved: {p_calib}")

    # ── console summary ───────────────────────────────────────────────────────
    print(f"\n  {'='*60}")
    print(f"  CALIBRATION SUMMARY")
    print(f"  {'='*60}")
    print(f"  Companion matrix A_1  (2×2):")
    print(f"                  lag δ        lag LD")
    print(f"    δ  equation:  {A1[0,0]:+.4f}       {A1[0,1]:+.4f}")
    print(f"    LD equation:  {A1[1,0]:+.4f}       {A1[1,1]:+.4f}")
    print(f"\n  ρ_δ  = {rho_delta:+.4f}  (model default: 0.617 from part6)")
    print(f"  ρ_LD = {rho_ld:+.4f}  (model default: 0.751 from part6)")
    print(f"  β (endogenous exit, LD←δ lag-1)  = {beta_endex:+.4f}")
    print(f"  α (reverse,        δ←LD lag-1)   = {alpha_rev:+.4f}")
    print(f"  corr(u^δ, u^LD) = {corr_innov:+.4f}")
    print(f"\n  Cholesky factor P:")
    print(f"    [[{P[0,0]:.4f},  0      ],")
    print(f"     [{P[1,0]:.4f}, {P[1,1]:.4f}]]")

    ratio = abs(beta_endex) / max(abs(alpha_rev), 1e-6)
    print(f"\n  INTERPRETATION:")
    if ratio > 1.5:
        print(f"  ✓ β ({beta_endex:+.4f}) > α ({alpha_rev:+.4f}), ratio={ratio:.1f}×.")
        print("    δ → LD cross-persistence exceeds LD → δ reverse.")
        print("    Consistent with δ as primitive shock (endogenous exit mechanism).")
        print("    See part2c LP Granger results for stronger horizon-by-horizon evidence.")
    else:
        print(f"  ! β ({beta_endex:+.4f}) ≈ α ({alpha_rev:+.4f}), ratio={ratio:.1f}×.")
        print("    VAR alone does not establish clear causal ordering at lag 1.")
        print("    Refer to part2c LP Granger results.")

    if abs(rho_delta - 0.617) > 0.10:
        print(f"\n  Note: ρ_δ={rho_delta:.3f} vs part6 aggregate (0.617). Difference is")
        print("  expected: time FEs absorb aggregate cycles; within-estimator reflects")
        print("  industry-specific variation only.")

    print(f"\n  Output: {p_irf}")
    print(f"          {p_calib}")
    print(f"          {RESULTS_DIR / 'var_lag_selection.csv'}")


# ═══════════════════════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    print("=" * 65)
    print("Part 2d  --  Bivariate Panel VAR Calibration")
    print("=" * 65)

    # ── 1. Panel ──────────────────────────────────────────────────────────────
    print("\n--- Section 1: Build residualized panel ---")
    nat = _build_panel()
    n_ind  = nat["industry_code"].nunique()
    t_span = f"{nat['quarter_label'].min()}–{nat['quarter_label'].max()}"
    K      = 2
    y_cols = ["nu_delta", "nu_ld"]

    # ── 2. Lag selection ──────────────────────────────────────────────────────
    print("\n--- Section 2: Lag selection (AIC / BIC) ---")
    lag_sel = []
    for L in range(1, MAX_LAGS + 1):
        A_list, Sigma, _, _, Y_dm = _estimate_var(nat, y_cols, L)
        N   = len(Y_dm)
        aic, bic = _aic_bic(Sigma, N, K, L)
        lag_sel.append({"L": L, "N": N, "AIC": aic, "BIC": bic})
        print(f"  L={L}  N={N}  AIC={aic:.5f}  BIC={bic:.5f}")

    lag_df = pd.DataFrame(lag_sel)
    lag_df.to_csv(RESULTS_DIR / "var_lag_selection.csv", index=False)

    best_aic = int(lag_df.loc[lag_df["AIC"].idxmin(), "L"])
    best_bic = int(lag_df.loc[lag_df["BIC"].idxmin(), "L"])
    # Disagrement → fall back to L=1 for parsimony and interpretability
    selected_lags = best_aic if best_aic == best_bic else 1
    print(f"\n  AIC best: L={best_aic}  |  BIC best: L={best_bic}"
          f"  →  selected: L={selected_lags}"
          + ("" if best_aic == best_bic else "  (disagree → L=1 for parsimony)"))

    # ── 3. Main VAR estimation ────────────────────────────────────────────────
    print(f"\n--- Section 3: VAR({selected_lags}) estimation ---")
    A_list, Sigma, _, _, Y_dm = _estimate_var(nat, y_cols, selected_lags)
    N_est = len(Y_dm)
    P     = np.linalg.cholesky(Sigma)

    corr_innov = Sigma[0, 1] / np.sqrt(Sigma[0, 0] * Sigma[1, 1])
    print(f"  N={N_est}  Var(u^δ)={Sigma[0,0]:.6f}  Var(u^LD)={Sigma[1,1]:.6f}"
          f"  Corr(u^δ,u^LD)={corr_innov:+.4f}")

    # ── 4. Structural IRFs ────────────────────────────────────────────────────
    print("\n--- Section 4: Structural IRFs and bootstrap CIs ---")
    irfs_point = _compute_structural_irfs(A_list, P, K, N_IRF)

    print(f"  {'Horizon':<8}  {'ε^δ→δ':>10}  {'ε^δ→LD':>10}"
          f"  {'ε^LD→δ':>10}  {'ε^LD→LD':>10}")
    for h in range(N_IRF + 1):
        print(f"  h={h:<6}  "
              f"{irfs_point['delta_to_delta'][h]:>10.4f}  "
              f"{irfs_point['delta_to_ld'][h]:>10.4f}  "
              f"{irfs_point['ld_to_delta'][h]:>10.4f}  "
              f"{irfs_point['ld_to_ld'][h]:>10.4f}")

    print(f"\n  Bootstrap CIs ({int(CI_LEVEL*100)}%, B=500)...")
    ci_lo, ci_hi = _bootstrap_irfs(nat, y_cols, selected_lags, K, N_IRF, B=500)
    print("  Bootstrap complete.")

    # ── 5. Output ─────────────────────────────────────────────────────────────
    print("\n--- Section 5: Output ---")
    _save_output(A_list, Sigma, P, irfs_point, ci_lo, ci_hi,
                 n_ind, t_span, N_est, selected_lags)

    print("\nDone.")


if __name__ == "__main__":
    main()
