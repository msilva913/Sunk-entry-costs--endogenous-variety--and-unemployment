def _build_lag_matrix(df, y_col, x_col, n_lags, h, industry_col="industry_code",
                      time_col="quarter_label"):
    """
    For each observation (j, t), construct:
      - dependent: Y_{j, t+h}
      - own lags:  Y_{j, t-1}, ..., Y_{j, t-L}
      - cross lags: X_{j, t-1}, ..., X_{j, t-L}
      - industry dummies and time dummies

    Returns (X_mat, y_vec, industry_ids, time_ids) with no NaN rows.
    """
    industries = sorted(df[industry_col].unique())
    quarters   = sorted(df[time_col].unique())
    q_index    = {q: i for i, q in enumerate(quarters)}
    ind_index  = {ind: i for i, ind in enumerate(industries)}

    rows = []
    for ind in industries:
        sub = df[df[industry_col] == ind].sort_values(time_col).reset_index(drop=True)
        T = len(sub)
        for t_idx in range(n_lags, T - h):
            # dependent variable: Y_{j, t+h}
            y_val = sub.loc[t_idx + h, y_col]
            # own lags: Y_{j, t-1}, ..., Y_{j, t-L}
            own = [sub.loc[t_idx - l, y_col] for l in range(1, n_lags + 1)]
            # cross lags: X_{j, t-1}, ..., X_{j, t-L}
            cross = [sub.loc[t_idx - l, x_col] for l in range(1, n_lags + 1)]

            qt = sub.loc[t_idx, time_col]
            rows.append({
                "y": y_val,
                **{f"own_lag{l}": own[l-1] for l in range(1, n_lags+1)},
                **{f"cross_lag{l}": cross[l-1] for l in range(1, n_lags+1)},
                "industry_id": ind_index[ind],
                "time_id":     q_index[qt],
                "industry":    ind,
                "quarter":     qt,
            })

    data = pd.DataFrame(rows).dropna()
    return data


def _within_transform(data, group_col, cols):
    """Subtract group means (within transformation) from specified columns."""
    out = data.copy()
    for col in cols:
        out[col] = out[col] - out.groupby(group_col)[col].transform("mean")
    return out


def _ols_with_f(X, y, n_cross_lags):
    """
    OLS returning coefficients, HC1 standard errors, and a Wald F-statistic
    for the joint significance of the last n_cross_lags regressors.
    HC1 = heteroskedasticity-robust (White), no clustering (industry n=12 too small).
    """
    n, k = X.shape
    if n <= k:
        return None

    XtX_inv = np.linalg.pinv(X.T @ X)
    beta    = XtX_inv @ X.T @ y
    resid   = y - X @ beta
    df_res  = n - k

    # HC1 covariance
    scale   = n / df_res
    meat    = (X * resid[:, None]).T @ (X * resid[:, None])
    V_hc1   = scale * XtX_inv @ meat @ XtX_inv

    se      = np.sqrt(np.diag(V_hc1))
    tstat   = beta / np.where(se > 0, se, np.nan)
    pval    = 2 * (1 - _norm_cdf(np.abs(tstat)))

    # Wald F on last n_cross_lags coefficients (cross-series lags)
    idx_cross = list(range(k - n_cross_lags, k))
    R = np.zeros((n_cross_lags, k))
    for i, j in enumerate(idx_cross):
        R[i, j] = 1.0
    Rb    = R @ beta
    RVR   = R @ V_hc1 @ R.T
    try:
        f_stat = (Rb @ np.linalg.solve(RVR, Rb)) / n_cross_lags
    except np.linalg.LinAlgError:
        f_stat = np.nan

    return {
        "beta":   beta,
        "se":     se,
        "tstat":  tstat,
        "pval":   pval,
        "f_stat": f_stat,
        "nobs":   n,
        "df_res": df_res,
    }


def _norm_cdf(x):
    """Standard normal CDF via error function."""
    from math import erf, sqrt
    return np.array([0.5 * (1 + erf(xi / sqrt(2))) for xi in np.atleast_1d(x)])


def run_granger_lp(nat, y_col, x_col, y_label, x_label,
                   n_lags=N_LAGS, horizons=HORIZONS):
    """
    Panel LP Granger causality: does X Granger-cause Y?

    At each horizon h, estimates:
        Y_{j,t+h} = α_j + α_t + Σ_l β_l Y_{j,t-l} + Σ_l γ_l X_{j,t-l} + ε

    Returns DataFrame with one row per horizon: h, gamma coefficients,
    their SEs and p-values, the joint F-stat on all γ_l, and cumulative IRF.
    """
    print(f"\n  [{y_label} ~ lags({y_label}) + lags({x_label})]")
    print(f"  {'h':>3}  {'γ_1':>8}  {'p(γ_1)':>7}  {'joint F':>8}  {'N':>6}")

    results = []
    for h in horizons:
        data = _build_lag_matrix(nat, y_col, x_col, n_lags, h)
        if len(data) < 30:
            continue

        # Absorb two-way FEs: within-industry then within-time on residuals
        all_cols = ["y"] + [f"own_lag{l}" for l in range(1, n_lags+1)] \
                         + [f"cross_lag{l}" for l in range(1, n_lags+1)]
        dm = _within_transform(data, "industry", all_cols)
        dm = _within_transform(dm,   "quarter",  all_cols)

        X_mat = dm[[f"own_lag{l}" for l in range(1, n_lags+1)] +
                   [f"cross_lag{l}" for l in range(1, n_lags+1)]].to_numpy()
        y_vec = dm["y"].to_numpy()

        res = _ols_with_f(X_mat, y_vec, n_cross_lags=n_lags)
        if res is None:
            continue

        # Cross-lag coefficients are the last n_lags entries of beta/se/pval
        gammas = res["beta"][-n_lags:]
        gamma_ses  = res["se"][-n_lags:]
        gamma_pval = res["pval"][-n_lags:]
        betas  = res["beta"][:n_lags]

        sig = ("***" if res["pval"][-n_lags] < .01 else
               "**"  if res["pval"][-n_lags] < .05 else
               "*"   if res["pval"][-n_lags] < .10 else "")
        print(f"  {h:3d}  {gammas[0]:+8.4f}  {gamma_pval[0]:7.4f}  "
              f"{res['f_stat']:8.3f}  {res['nobs']:6d}  {sig}")

        row = {"h": h, "f_stat": res["f_stat"], "nobs": res["nobs"]}
        for l in range(1, n_lags+1):
            row[f"gamma_{l}"]    = gammas[l-1]
            row[f"gamma_{l}_se"] = gamma_ses[l-1]
            row[f"gamma_{l}_p"]  = gamma_pval[l-1]
            row[f"beta_{l}"]     = betas[l-1]
        results.append(row)

    return pd.DataFrame(results)


# ═══════════════════════════════════════════════════════════════════════════════
#  SECTION 3: CUMULATIVE IRF
#  Traces how a 1-SD impulse in X_{t-1} propagates into Y over subsequent
#  quarters, accounting for both the direct cross-lag effect and the
#  persistence of Y's own dynamics.
# ═══════════════════════════════════════════════════════════════════════════════

def _cumulative_irf(nat, y_col, x_col, n_lags=N_LAGS, H=max(HORIZONS)):
    """
    Simulate cumulative IRF of Y to a 1-SD shock in X at t=0,
    using the LP coefficients from a single-horizon regression (h=0)
    to get the companion matrix, then iterating forward.

    Because LP coefficients vary by h (they're not constrained to be
    VAR-consistent), we instead report the direct LP estimate at each h:
    this is simply gamma_1(h) * SD(X) -- the coefficient on X_{t-1}
    in the h-step-ahead regression, scaled to a 1-SD X shock.
    This is the LP analog of an MA coefficient at lag h+1.
    """
    sd_x = nat[x_col].std()
    rows = []
    for h in range(0, H + 1):
        data = _build_lag_matrix(nat, y_col, x_col, n_lags, h)
        if len(data) < 30:
            continue
        all_cols = ["y"] + [f"own_lag{l}" for l in range(1, n_lags+1)] \
                         + [f"cross_lag{l}" for l in range(1, n_lags+1)]
        dm = _within_transform(data, "industry", all_cols)
        dm = _within_transform(dm,   "quarter",  all_cols)
        X_mat = dm[[f"own_lag{l}" for l in range(1, n_lags+1)] +
                   [f"cross_lag{l}" for l in range(1, n_lags+1)]].to_numpy()
        y_vec = dm["y"].to_numpy()
        res   = _ols_with_f(X_mat, y_vec, n_cross_lags=n_lags)
        if res is None:
            continue
        gamma_1    = res["beta"][-n_lags]        # coefficient on X_{t-1}
        gamma_1_se = res["se"][-n_lags]
        irf_val    = gamma_1 * sd_x
        irf_se     = gamma_1_se * sd_x
        rows.append({"h": h, "irf": irf_val, "irf_se": irf_se,
                     "gamma_1": gamma_1, "pval": res["pval"][-n_lags]})
    return pd.DataFrame(rows)


