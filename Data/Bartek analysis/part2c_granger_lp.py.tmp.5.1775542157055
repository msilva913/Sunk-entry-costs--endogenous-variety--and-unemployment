    ("QU",  "δ",  "δ → QU\n(Does destruction cause quits?)",         "#2ca02c"),
    ("δ",   "QU", "QU → δ\n(Do quits predict future closings?)",     "#ff7f0e"),
    ("QU",  "LD", "LD → QU",                                          "#9467bd"),
    ("LD",  "QU", "QU → LD",                                          "#8c564b"),
]

z_ci = 1.645 if CI_LEVEL == 0.90 else 1.960

for ax, (y_lbl, x_lbl, title, color) in zip(axes, plot_pairs):
