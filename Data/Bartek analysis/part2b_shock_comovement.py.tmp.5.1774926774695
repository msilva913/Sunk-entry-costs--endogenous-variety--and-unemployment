def _fetch_bea_va(bea_key: str) -> pd.DataFrame:
    """
    Fetch real quarterly value-added by industry from BEA GDPbyIndustry.
    Returns a DataFrame with columns: quarter_label, bea_industry, DataValue.
    Raises ValueError with the BEA error message if the API returns an error.
    """
    import requests
    url = "https://apps.bea.gov/api/data"
    params = {
        "UserID": bea_key,
        "method": "GetData",
        "DataSetName": "GDPbyIndustry",
        "TableID": "1",        # Value Added, real
        "Frequency": "Q",
        "Year": "ALL",
        "Industry": "ALL",
        "ResultFormat": "JSON",
    }
    print("  Fetching BEA GDPbyIndustry (real VA, all quarters, all industries) ...")
    r = requests.get(url, params=params, timeout=60)
    r.raise_for_status()
    data = r.json()

    import json

    # Defensive parse: BEA response structure varies by endpoint/version.
    beaapi = data.get("BEAAPI", data)

    # Top-level error key
    if "Error" in beaapi:
        raise ValueError(f"BEA API error: {beaapi['Error']}")

    results = beaapi.get("Results", {})

    # Results can be a list (multiple result sets) or a dict (single).
    # When a list, the data table is the first element.
    if isinstance(results, list):
        print(f"  BEA Results is a list ({len(results)} element(s)); "
              "using first.")
        results = results[0] if results else {}

    # Error nested inside Results dict
    if isinstance(results, dict) and "Error" in results:
        raise ValueError(f"BEA API error: {results['Error']}")

    rows = results.get("Data") if isinstance(results, dict) else None
    if rows is None:
        raise ValueError(
            f"BEA response missing 'Data'. "
            f"results type={type(results).__name__}, "
            f"beaapi keys={list(beaapi.keys())}. "
            f"Response (truncated):\n{json.dumps(data, indent=2)[:1500]}"
        )

    df = pd.DataFrame(rows)
    print(f"  BEA raw columns: {list(df.columns)}")
    print(f"  BEA sample row:  {df.iloc[0].to_dict() if len(df) else 'empty'}")

    # Identify the correct column names dynamically — BEA has varied these
    # across API versions. Map common alternatives to canonical names.
    col_map = {}
    for c in df.columns:
        cl = c.lower()
        if cl in ("timeperiod", "time_period", "period"):
            col_map[c] = "quarter_label"
        elif cl in ("industry", "industryid", "industry_id"):
            col_map[c] = "bea_industry"
        elif cl in ("datavalue", "data_value", "value"):
            col_map[c] = "DataValue"
    df = df.rename(columns=col_map)

    needed = {"quarter_label", "bea_industry", "DataValue"}
    missing_cols = needed - set(df.columns)
    if missing_cols:
        raise ValueError(
            f"BEA DataFrame missing expected columns {missing_cols}. "
            f"Available: {list(df.columns)}"
        )

    df = df[["bea_industry", "quarter_label", "DataValue"]].copy()
    df["DataValue"] = pd.to_numeric(
        df["DataValue"].astype(str).str.replace(",", ""), errors="coerce"
    )
    df = df.dropna(subset=["DataValue"])
    print(f"  BEA: {len(df):,} rows, "
          f"{df['bea_industry'].nunique()} industries, "
          f"{df['quarter_label'].nunique()} quarters")
    return df

def _build_bls_va(raw_bea: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate BEA NAICS-level VA to BLS supersectors, compute Dlog VA.
    Returns: quarter_label, industry_code (BLS), dlog_va
    """
    records = []
    for bls_code, bea_ids in BLS_TO_BEA.items():
        sub = raw_bea[raw_bea["bea_industry"].isin(bea_ids)].copy()
        if sub.empty:
            print(f"  WARNING: no BEA data for BLS {bls_code} "
                  f"(BEA ids: {bea_ids})")
            continue
        agg = (sub.groupby("quarter_label")["DataValue"]
                  .sum().reset_index()
                  .rename(columns={"DataValue": "va"}))
        agg = agg.sort_values("quarter_label").reset_index(drop=True)
        agg["log_va"]  = np.log(agg["va"].replace(0, np.nan))
        agg["dlog_va"] = agg["log_va"].diff()
        agg["industry_code"] = bls_code
        records.append(agg[["quarter_label", "industry_code", "dlog_va"]].dropna())
    return pd.concat(records, ignore_index=True)

